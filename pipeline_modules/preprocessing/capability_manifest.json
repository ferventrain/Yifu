{
  "schema_version": "1",
  "module": "preprocessing",
  "description": "Config-driven TIFF preprocessing, registration-channel downsampling, TIFF-to-Zarr conversion, edge-signal removal, and mask upsampling.",
  "entrypoints": [
    {
      "id": "run_preprocessing",
      "function": "pipeline_modules.preprocessing.preprocessor.run_preprocessing",
      "cli": "python -m pipeline_modules.preprocessing.preprocessor",
      "description": "Apply optional channel subtraction plus ordered enhancement steps to one or more TIFF channels and emit per-channel manifests.",
      "prerequisites": [
        "Sample directory must exist",
        "Requested channel TIFF directories must exist and contain TIFF slices"
      ],
      "inputs": {
        "sample_dir": { "type": "path", "required": true },
        "preprocessing_config": { "type": "object", "required": true, "description": "PreprocessingCfg-compatible mapping" },
        "channel": { "type": "string|null", "default": null, "description": "Optional channel override such as '1' or 'ch1'" },
        "max_workers": { "type": "int|null", "default": null },
        "resume": { "type": "bool", "default": true },
        "output_dir": { "type": "path|null", "default": null, "description": "Optional custom root for chX_preprocessed outputs" },
        "config_path": { "type": "path|null", "default": null, "description": "Optional config.json path used when caching adaptive weights" },
        "signal_ch": { "type": "string", "default": "ch0" },
        "reg_ch": { "type": "string", "default": "ch1" }
      },
      "outputs": {
        "channels": { "type": "array", "description": "Per-channel preprocessing results" },
        "manifest_paths": { "type": "array", "description": "Per-output-directory _run_manifest.json paths" }
      }
    },
    {
      "id": "convert_tiff_to_zarr",
      "function": "pipeline_modules.preprocessing.tiff_to_zarr.convert_tiff_to_zarr",
      "cli": "python pipeline_modules/preprocessing/tiff_to_zarr.py",
      "description": "Convert a TIFF stack directory into a directory-store Zarr volume with basic multiscales metadata.",
      "prerequisites": [
        "Input TIFF directory must exist and contain TIFF slices"
      ],
      "inputs": {
        "input_dir": { "type": "path", "required": false, "description": "Single-channel TIFF folder; required unless using sample_dir + channels batch mode" },
        "output_zarr": { "type": "path", "required": false, "description": "Single-channel output .zarr; required unless using sample_dir + channels batch mode" },
        "sample_dir": { "type": "dir", "required": false, "description": "Sample root for batch conversion of ch0,ch1,..." },
        "channels": { "type": "string", "required": false, "examples": ["0,1,2,3"], "description": "Comma-separated channel labels for batch mode" },
        "chunk_size": { "type": "triplet_int", "default": [256, 256, 256] },
        "workers": { "type": "int", "default": 0, "description": "Thread count for parallel TIFF chunk reads; 0 uses cpu_count // 4" },
        "skip_existing": { "type": "bool", "default": false, "description": "In batch mode, skip channels whose chX.zarr already exists" },
        "compressor": { "type": "string", "default": "default" },
        "dataset_name": { "type": "string", "default": "0" }
      },
      "outputs": {
        "output_zarr": { "type": "dir", "description": "Directory-store Zarr output" },
        "manifest_path": { "type": "path", "description": "_run_manifest.json inside the Zarr store root" }
      }
    },
    {
      "id": "downsample_folder",
      "function": "pipeline_modules.preprocessing.downsample.downsample_folder",
      "cli": "python pipeline_modules/preprocessing/downsample.py",
      "description": "Downsample a 3D TIFF stack into a new TIFF stack plus NIfTI volume, using nearest-neighbour interpolation.",
      "prerequisites": [
        "Input TIFF directory must exist and contain TIFF slices or a single OME-TIFF"
      ],
      "inputs": {
        "input_folder": { "type": "path", "required": true },
        "resolution_config_path": { "type": "path|null", "default": null },
        "manual_factors": { "type": "triplet_float|null", "default": null, "description": "Downsample factors in z,y,x order" },
        "output_folder": { "type": "path|null", "default": null },
        "is_mask": { "type": "bool", "default": false },
        "chunk_size": { "type": "int", "default": 100 }
      },
      "outputs": {
        "output_dir": { "type": "dir", "description": "Downsampled TIFF stack directory" },
        "nifti_path": { "type": "path", "description": "volume.nii.gz" },
        "manifest_path": { "type": "path", "description": "_run_manifest.json" }
      }
    },
    {
      "id": "remove_edge_signal",
      "function": "pipeline_modules.preprocessing.edge_signal_removal.remove_edge_signal",
      "cli": "python pipeline_modules/preprocessing/edge_signal_removal.py",
      "description": "Suppress bright sheet-like edge noise in signal TIFF stacks using a warped atlas label mask. Wired into main.py when preprocessing.edge_signal_removal.apply=true (requires registration label).",
      "prerequisites": [
        "Signal TIFF directory and warped atlas label TIFF directory must exist with matching slice counts",
        "Usually runs after registration produces sample_dir/upsampled_atlas_label/"
      ],
      "inputs": {
        "input_dir": { "type": "path", "required": true, "description": "Signal TIFF folder, commonly sample_dir/<signal_ch>/" },
        "label_dir": { "type": "path", "required": true, "description": "Warped atlas label TIFF folder, commonly sample_dir/upsampled_atlas_label/" },
        "output_dir": { "type": "path", "required": true, "description": "Cleaned TIFF folder or downstream Zarr input" },
        "inward_px": { "type": "int", "default": 50 },
        "outward_px": { "type": "int", "default": 0 },
        "suppression_weight": { "type": "float", "default": 0.8 },
        "brightness_pct": { "type": "float", "default": 90.0 },
        "smooth_sigma": { "type": "float", "default": 5.0 },
        "min_area_px": { "type": "int", "default": 50 },
        "max_workers": { "type": "int", "default": 8 },
        "no_resume": { "type": "bool", "default": false }
      },
      "outputs": {
        "output_dir": { "type": "dir", "description": "Cleaned TIFF stack directory" },
        "manifest_path": { "type": "path", "description": "_run_manifest.json" }
      }
    },
    {
      "id": "upsample_mask_zarr",
      "function": "pipeline_modules.preprocessing.upsample_mask.main",
      "cli": "python pipeline_modules/preprocessing/upsample_mask.py",
      "description": "Nearest-neighbour upsample a downsampled mask Zarr back to full-resolution shape guided by a full-resolution signal Zarr.",
      "inputs": {
        "input_mask_zarr": { "type": "path", "required": true },
        "output_mask_zarr": { "type": "path", "required": true },
        "full_res_zarr": { "type": "path", "required": true },
        "chunk_size": { "type": "triplet_int", "default": [128, 256, 256] }
      },
      "outputs": {
        "output_mask_zarr": { "type": "dir" }
      }
    },
    {
      "id": "channel_subtraction",
      "function": "pipeline_modules.preprocessing.channel_subtraction.process_channel_subtraction",
      "cli": "python pipeline_modules/preprocessing/channel_subtraction.py",
      "description": "Parallel subtract a background channel from a target channel in TIFF stacks for autofluorescence removal. Also available through run_preprocessing when preprocessing.channel_subtraction is configured.",
      "inputs": {
        "path": { "type": "path", "required": true, "description": "Root path containing channel folders" },
        "bg_channel": { "type": "string", "default": "ch0" },
        "workers": { "type": "int|null", "default": null },
        "compression": { "type": "string", "default": "lzw", "choices": ["lzw", "none", "zlib"] },
        "weight": { "type": "float", "default": 1.0 },
        "adaptive": { "type": "bool", "default": false },
        "save_plots": { "type": "bool", "default": false },
        "sample_ratio": { "type": "float", "default": 0.005 },
        "min_samples": { "type": "int", "default": 10 },
        "max_samples": { "type": "int", "default": 50 }
      },
      "outputs": {
        "subtracted_tiff_dir": { "type": "dir", "description": "Per-channel subtracted TIFF output folders under the sample root" }
      }
    }
  ],
  "configuration_models": {
    "PreprocessingCfg": "pipeline_modules.preprocessing.config.PreprocessingCfg",
    "DownsampleCfg": "pipeline_modules.preprocessing.config.DownsampleCfg",
    "ZarrCfg": "pipeline_modules.preprocessing.config.ZarrCfg"
  },
  "sample_layout": {
    "class": "pipeline_modules.utils.sample_layout.SampleLayout",
    "relevant_paths": {
      "signal_tiff_dir": "SampleLayout.signal_tiff_dir",
      "signal_tiff_preprocessed_dir": "SampleLayout.signal_tiff_preprocessed_dir",
      "reg_tiff_dir": "SampleLayout.reg_tiff_dir",
      "signal_zarr": "SampleLayout.signal_zarr",
      "reg_downsample_dir": "SampleLayout.reg_downsample_dir",
      "reg_downsample_nii": "SampleLayout.reg_downsample_nii"
    }
  }
}
