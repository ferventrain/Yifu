{
    "project_name": "Template",
    
    "input": {
        "description": "Configuration for input data structure",
        "resolution_xyz": [1.8, 1.8, 2.0],
        "channels": {
            "signal": "1",
            "registration": "0"
        }
    },
    
    "preprocessing": {
        "downsample": {
            "target_resolution_xyz": [25.0, 25.0, 25.0],
            "chunk_size": 100  
        },
        "zarr": {
            "chunk_size": [256, 512, 512],
            "compressor": "default"
        }
    },
    
    "registration": {
        "method": "ants",
        "mode": "atlas2image",
        "atlas_path": "S:\\Yifu\\data\\reference\\atlas.nii.gz",
        "annotation_path": "S:\\Yifu\\data\\reference\\atlas_label.nii.gz",
        "transform_type": "SyN",
        "allow_reflection": false
    },
    "segmentation": {
        "method": "threshold", 
        
        "cellpose": {
            "model": "cyto3",
            "diameter": 30.0,
            "use_gpu": true,
            "workers": 4,
            "block_size": [256, 512, 512]
        },
        
        "threshold": {
            "value": "1000",
            "sigma": 0,
            "min_object_size": 0
        }
    },
    
    "analysis": {
        "density_config": "pipeline_modules/registration/Region_Csv_Rev1_updated.CSV",
        "output_format": "xlsx"
    }
}
