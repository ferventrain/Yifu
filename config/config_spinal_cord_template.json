{
    "project_name": "SpinalCord",
    "mode": "spinal_cord",

    "input": {
        "resolution_xyz": [1.8, 1.8, 2.0],
        "channels": {
            "signal": "0",
            "registration": "1"
        }
    },

    "preprocessing": {
        "channel_subtraction": {
            "apply": false,
            "background_channel": "ch0",
            "weight": 1.0,
            "adaptive": true,
            "save_plots": true,
            "sample_ratio": 0.005,
            "min_samples": 10,
            "max_samples": 50,
            "compression": "lzw"
        },
        "tophat": {
            "apply": false,
            "kernel_size": 21
        },
        "rolling_ball": {
            "apply": false,
            "radius": 50
        },
        "scattering_removal": {
            "apply": false,
            "sigma": 50.0,
            "weight": 1.0
        },
        "median_filter": {
            "apply": true,
            "kernel_size": 3
        },
        "clahe": {
            "apply": false,
            "clip_limit": 2.0,
            "tile_grid_size": 8
        },
        "surface_brightness_homogenize": {
            "apply": false,
            "downsample": 8,
            "field_sigma_px": 64.0,
            "alpha": 1.0,
            "interior_pct": 50.0,
            "strength": 2.0,
            "close_iter": 0,
            "seed_pct": 90.0,
            "grow_pct": 84.0,
            "max_grow_px": 32.0,
            "erode_px": 16.0,
            "max_workers": 0
        },
        "edge_signal_removal": {
            "apply": false,
            "inward_px": 50,
            "outward_px": 0,
            "prior_curve_scale": 1.15,
            "prior_curve_smooth_sigma": 2.0,
            "contour_min_object_area_px": 50,
            "contour_morph_radius_px": 2,
            "contour_dilation_px": 2,
            "brightness_pct": 90.0,
            "min_area_px": 50,
            "suppression_weight": 1.0,
            "max_workers": 8
        },
        "downsample": {
            "target_resolution_xyz": [25.0, 25.0, 25.0],
            "chunk_size": 100
        },
        "zarr": {
            "chunk_size": [128, 256, 256],
            "compressor": "default"
        }
    },

    "registration": {
        "method": "ants",
        "mode": "atlas2image",
        "atlas_path": "${YIFU_DATA_DIR}/reference/atlas.tiff",
        "annotation_path": "${YIFU_DATA_DIR}/reference/atlas_label.tiff",
        "transform_type": "SyN",
        "allow_reflection": false,
        "save_upsampled_label": true,
        "save_upsampled_label_zarr": true,
        "save_upsampled_label_hemisphere_zarr": false
    },

    "segmentation": {
        "method": "threshold",
        "export_mask_tiff": false,
        "threshold": {
            "value": "2000",
            "sigma": 0,
            "min_object_size": 10
        }
    },

    "analysis": {
        "density_config": "pipeline_modules/registration/Region_Csv_Rev1_updated.CSV",
        "output_format": "xlsx",
        "use_hemisphere_label": false
    },

    "spinal_cord": {
        "segments_zarr": "spinalj_segments",
        "segments_legend_csv": "",
        "rerun": false,
        "analysis": {
            "min_voxels": 300,
            "max_voxels": 5000,
            "pass1_workers": 4
        }
    }
}
