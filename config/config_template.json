{
    "project_name": "Template",
    
    "input": {
        "description": "Configuration for input data structure",
        "resolution_xyz": [1.8, 1.8, 2.0],
        "channels": {
            "signal": "0",
            "registration": "1"
        }
    },
    
    "preprocessing": {
        "channel_subtraction": {
            "apply": true,
            "background_channel": "ch0",
            "weight": 1.0,
            "adaptive": true,
            "save_plots": true,
            "sample_ratio": 0.005,
            "min_samples": 10,
            "max_samples": 50,
            "compression": "lzw"
        },
        "tophat": {
            "apply": false,
            "kernel_size": 21
        },
        "rolling_ball": {
            "apply": false,
            "radius": 50
        },
        "scattering_removal": {
            "apply": false,
            "sigma": 50.0,
            "weight": 1.0
        },
        "median_filter": {
            "apply": true,
            "kernel_size": 3
        },
        "clahe": {
            "apply": false,
            "clip_limit": 2.0,
            "tile_grid_size": 8
        },
        "edge_signal_removal": {
            "apply": false,
            "inward_px": 50,
            "outward_px": 0,
            "prior_curve_scale": 1.15,
            "prior_curve_smooth_sigma": 2.0,
            "contour_min_object_area_px": 50,
            "contour_morph_radius_px": 2,
            "contour_dilation_px": 2,
            "brightness_pct": 90.0,
            "min_area_px": 50,
            "suppression_weight": 1.0,
            "max_workers": 8
        },
        "downsample": {
            "target_resolution_xyz": [25.0, 25.0, 25.0],
            "chunk_size": 100  
        },
        "zarr": {
            "chunk_size": [128, 256, 256],
            "compressor": "default"
        }
    },
    
    "registration": {
        "method": "ants",
        "mode": "atlas2image",
        "atlas_path": "${YIFU_DATA_DIR}/reference/atlas.tiff",
        "annotation_path": "${YIFU_DATA_DIR}/reference/atlas_label.tiff",
        "transform_type": "SyN",
        "allow_reflection": false,
        "save_upsampled_label": true,
        "save_upsampled_label_zarr": true,
        "save_upsampled_label_hemisphere_zarr": false
    },
    
    "segmentation": {
        "method": "threshold",
        "export_mask_tiff": false,
        
        "cellpose": {
            "model": "cyto3",
            "diameter": 30.0,
            "use_gpu": true,
            "workers": 4,
            "block_size": [128, 256, 256]
        },
        
        "threshold": {
            "value": "1000",
            "sigma": 0,
            "min_object_size": 10
        },

        "cfos_unet": {
            "checkpoint_path": "${YIFU_DATA_DIR}/models/cfos/best_model.pt",
            "save_probability": true,
            "probability_zarr": "",
            "dataset_name": "0",
            "patch_size": [128, 128, 128],
            "overlap": 0.25,
            "batch_size": 4,
            "device": "auto",
            "foreground_class": 1,
            "probability_threshold": 0.5,
            "process_existing_only": false,
            "skip_below_threshold": 100.0,
            "rerun_if_model_updated": true,
            "output_mode": "binary",
            "output_dtype": "uint8",
            "probability_dtype": "float16",
            "normalize_percentiles": [1.0, 99.5]
        },

        "spotiflow": {
            "model_dir": "model/spotiflow",
            "output_csv": "",
            "region_counts_csv": "",
            "summary_json": "",
            "label_zarr": "",
            "cfg": "pipeline_modules/registration/Region_Csv_Rev1_updated.CSV",
            "dataset_name": "0",
            "which": "best",
            "prob_thresh": 0.35,
            "min_distance": 1,
            "tile_size": null,
            "tile_overlap": 16,
            "skip_below_threshold": 100.0,
            "device": "auto",
            "peak_mode": "fast",
            "normalizer": "auto",
            "subpix": null,
            "use_tuned_tile_overlap": false,
            "rerun_if_model_updated": true
        }
    },
    
    "analysis": {
        "density_config": "pipeline_modules/registration/Region_Csv_Rev1_updated.CSV",
        "output_format": "xlsx",
        "use_hemisphere_label": false
    },

    "tubule_reconstruction": {
        "enabled": true,
        "mask_dataset_name": "0",
        "foreground_label": 1,
        "dust_threshold": 100,
        "fix_borders": true,
        "parallel": 1,
        "save_skeleton": true,
        "save_swc": false,
        "chunkwise": true,
        "chunk_workers": 8,
        "process_existing_only": true,
        "halo_zyx": [2, 4, 4],
        "stitch": true,
        "stitch_max_distance_um": 5.0,
        "downsample_factor": 4,
        "keep_downsampled_mask": false,
        "merge_branch_points_distance_um": 0.0,
        "prune_spurs_max_length_um": 0.0,
        "output_dirname": "tubule_reconstruction",
        "teasar_params": {
            "scale": 1.5,
            "const": 300,
            "pdrf_scale": 100000,
            "pdrf_exponent": 4,
            "soma_acceptance_threshold": 3500,
            "soma_detection_threshold": 750,
            "soma_invalidation_scale": 1.0,
            "soma_invalidation_const": 300,
            "max_paths": null
        },
        "region_analysis": {
            "enabled": true,
            "all_regions": true,
            "regions": [],
            "cfg": "pipeline_modules/registration/Region_Csv_Rev1_updated.CSV",
            "mask_dataset_name": "0",
            "foreground_label": 1,
            "annotation_dataset_name": "0"
        }
    }
}
