{
    "project_name": "Template",
    
    "input": {
        "description": "Configuration for input data structure",
        "resolution_xyz": [1.8, 1.8, 2.0],
        "channels": {
            "signal": "0",
            "registration": "1"
        }
    },
    
    "preprocessing": {
        "channel_subtraction": {
            "apply": false,
            "background_channel": "ch0",
            "weight": 1.0,
            "adaptive": true,
            "save_plots": true,
            "sample_ratio": 0.005,
            "min_samples": 10,
            "max_samples": 50,
            "compression": "lzw"
        },
        "tophat": {
            "apply": false,
            "kernel_size": 21
        },
        "scattering_removal": {
            "apply": false,
            "sigma": 50.0,
            "weight": 1.0
        },
        "clahe": {
            "apply": false,
            "clip_limit": 2.0,
            "tile_grid_size": 8
        },
        "downsample": {
            "target_resolution_xyz": [25.0, 25.0, 25.0],
            "chunk_size": 100  
        },
        "zarr": {
            "chunk_size": [128, 256, 256],
            "compressor": "default"
        }
    },
    
    "registration": {
        "method": "ants",
        "mode": "atlas2image",
        "atlas_path": "s:/Yifu/Allen_brainatlas/atlas.tiff",
        "annotation_path": "s:/Yifu/Allen_brainatlas/atlas_label.tiff",
        "transform_type": "SyN",
        "allow_reflection": false
    },
    
    "segmentation": {
        "method": "threshold", 
        
        "cellpose": {
            "model": "cyto3",
            "diameter": 30.0,
            "use_gpu": true,
            "workers": 4,
            "block_size": [128, 256, 256]
        },
        
        "threshold": {
            "value": "1000",
            "sigma": 0,
            "min_object_size": 10
        }
    },
    
    "analysis": {
        "density_config": "pipeline_modules/registration/Region_Csv_Rev1_updated.CSV",
        "output_format": "xlsx"
    }
}
