{
    "project_name": "Template",
    
    "input": {
        "description": "Configuration for input data structure",
        "resolution_xyz": [1.8, 1.8, 2.0],
        "channels": {
            "signal": "0",
            "registration": "1"
        }
    },
    
    "preprocessing": {
        "channel_subtraction": {
            "apply": true,
            "background_channel": "ch0",
            "weight": 1.0,
            "adaptive": true,
            "save_plots": true,
            "sample_ratio": 0.005,
            "min_samples": 10,
            "max_samples": 50,
            "compression": "lzw"
        },
        "tophat": {
            "apply": false,
            "kernel_size": 21
        },
        "rolling_ball": {
            "apply": false,
            "radius": 50
        },
        "scattering_removal": {
            "apply": false,
            "sigma": 50.0,
            "weight": 1.0
        },
        "median_filter": {
            "apply": true,
            "kernel_size": 3
        },
        "clahe": {
            "apply": false,
            "clip_limit": 2.0,
            "tile_grid_size": 8
        },
        "edge_signal_removal": {
            "apply": false,
            "edge_width_px": 20,
            "prior_curve_scale": 1.15,
            "prior_curve_smooth_sigma": 2.0,
            "contour_min_object_area_px": 50,
            "contour_morph_radius_px": 2,
            "contour_dilation_px": 2,
            "brightness_pct": 90.0,
            "min_area_px": 50,
            "suppression_weight": 1.0,
            "max_workers": 8
        },
        "tubular_enhancement": {
            "apply": false,
            "method": "frangi",
            "sigmas": [1, 2, 4, 8],
            "black_ridges": false,
            "export_tiff": false
        },
        "downsample": {
            "target_resolution_xyz": [25.0, 25.0, 25.0],
            "chunk_size": 100  
        },
        "zarr": {
            "chunk_size": [128, 256, 256],
            "compressor": "default"
        }
    },
    
    "registration": {
        "method": "ants",
        "mode": "atlas2image",
        "atlas_path": "s:/Yifu/Allen_brainatlas/atlas.tiff",
        "annotation_path": "s:/Yifu/Allen_brainatlas/atlas_label.tiff",
        "transform_type": "SyN",
        "allow_reflection": false,
        "save_upsampled_label": true,
        "save_upsampled_label_zarr": true
    },
    
    "segmentation": {
        "method": "threshold",
        "export_mask_tiff": false,
        
        "cellpose": {
            "model": "cyto3",
            "diameter": 30.0,
            "use_gpu": true,
            "workers": 4,
            "block_size": [128, 256, 256]
        },
        
        "threshold": {
            "value": "1000",
            "sigma": 0,
            "min_object_size": 10
        },

        "cfos_unet": {
            "checkpoint_path": "S:/Yifu/models/cfos/best_model.pt",
            "save_probability": true,
            "probability_zarr": "",
            "dataset_name": "0",
            "patch_size": [128, 128, 128],
            "overlap": 0.25,
            "batch_size": 4,
            "device": "auto",
            "foreground_class": 1,
            "probability_threshold": 0.5,
            "process_existing_only": false,
            "skip_below_threshold": 100.0,
            "rerun_if_model_updated": true,
            "output_mode": "binary",
            "output_dtype": "uint8",
            "probability_dtype": "float16",
            "normalize_percentiles": [1.0, 99.5]
        }
    },
    
    "analysis": {
        "density_config": "pipeline_modules/registration/Region_Csv_Rev1_updated.CSV",
        "output_format": "xlsx"
    }
}
