{
  "project_name": "Template",
  "input": {
    "description": "Configuration for input data structure",
    "resolution_xyz": [
      1.8,
      1.8,
      2.0
    ],
    "channels": {
      "signal": "0",
      "registration": "1"
    }
  },
  "preprocessing": {
    "channel_subtraction": {
      "apply": true,
      "background_channel": "ch0",
      "weight": 1.0,
      "adaptive": true,
      "save_plots": true,
      "sample_ratio": 0.01,
      "min_samples": 10,
      "max_samples": 50,
      "compression": "lzw",
      "estimated_weights": {
        "ch1": 0.5,
        "ch2": 0.5
      }
    },
    "tophat": {
      "apply": true,
      "kernel_size": 21
    },
    "rolling_ball": {
      "apply": false,
      "radius": 50
    },
    "scattering_removal": {
      "apply": true,
      "sigma": 25.0,
      "weight": 1.0
    },
    "median_filter": {
      "apply": true,
      "kernel_size": 5
    },
    "clahe": {
      "apply": false,
      "clip_limit": 2.0,
      "tile_grid_size": 8
    },
    "edge_signal_removal": {
      "apply": false,
      "edge_width_px": 20,
      "suppression_weight": 0.8,
      "brightness_pct": 90.0,
      "smooth_sigma": 5.0,
      "export_tiff": false
    },
    "tubular_enhancement": {
      "apply": false,
      "method": "frangi",
      "sigmas": [
        1,
        2,
        4,
        8
      ],
      "black_ridges": false,
      "export_tiff": false
    },
    "downsample": {
      "target_resolution_xyz": [
        25.0,
        25.0,
        25.0
      ],
      "chunk_size": 100
    },
    "zarr": {
      "chunk_size": [
        128,
        256,
        256
      ],
      "compressor": "default"
    },
    "channels": [
      1,
      2,
      3
    ]
  },
  "registration": {
    "method": "ants",
    "mode": "atlas2image",
    "atlas_path": "s:/Yifu/Allen_brainatlas/atlas.tiff",
    "annotation_path": "s:/Yifu/Allen_brainatlas/atlas_label.tiff",
    "transform_type": "SyN",
    "allow_reflection": false
  },
  "segmentation": {
    "method": "threshold",
    "export_mask_tiff": false,
    "cellpose": {
      "model": "cyto3",
      "diameter": 30.0,
      "use_gpu": true,
      "workers": 4,
      "block_size": [
        128,
        256,
        256
      ]
    },
    "threshold": {
      "value": "1000",
      "sigma": 0,
      "min_object_size": 10
    }
  },
  "analysis": {
    "density_config": "pipeline_modules/registration/Region_Csv_Rev1_updated.CSV",
    "output_format": "xlsx"
  }
}
