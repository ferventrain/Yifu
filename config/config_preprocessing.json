{
  "project_name": "Template",
  "input": {
    "description": "Configuration for input data structure",
    "resolution_xyz": [
      1.8,
      1.8,
      2.0
    ],
    "channels": {
      "signal": "0",
      "registration": "1"
    }
  },
  "preprocessing": {
    "channel_subtraction": {
      "apply": true,
      "background_channel": "ch0",
      "weight": 1.0,
      "adaptive": true,
      "save_plots": true,
      "sample_ratio": 0.01,
      "min_samples": 10,
      "max_samples": 50,
      "compression": "lzw",
      "estimated_weights": {
        "ch1": 0.5,
        "ch2": 0.5
      }
    },
    "tophat": {
      "apply": true,
      "kernel_size": 21
    },
    "rolling_ball": {
      "apply": false,
      "radius": 50
    },
    "scattering_removal": {
      "apply": true,
      "sigma": 25.0,
      "weight": 1.0
    },
    "median_filter": {
      "apply": true,
      "kernel_size": 5
    },
    "clahe": {
      "apply": false,
      "clip_limit": 2.0,
      "tile_grid_size": 8
    },
    "edge_signal_removal": {
      "apply": false,
      "inward_px": 50,
      "outward_px": 0,
      "prior_curve_scale": 1.15,
      "prior_curve_smooth_sigma": 2.0,
      "contour_min_object_area_px": 50,
      "contour_morph_radius_px": 2,
      "contour_dilation_px": 2,
      "brightness_pct": 90.0,
      "min_area_px": 50,
      "suppression_weight": 1.0,
      "max_workers": 8
    },
    "downsample": {
      "target_resolution_xyz": [
        25.0,
        25.0,
        25.0
      ],
      "chunk_size": 100
    },
    "zarr": {
      "chunk_size": [
        128,
        256,
        256
      ],
      "compressor": "default"
    },
    "channels": [
      1,
      2,
      3
    ]
  },
  "registration": {
    "method": "ants",
    "mode": "atlas2image",
    "atlas_path": "${YIFU_DATA_DIR}/reference/atlas.tiff",
    "annotation_path": "${YIFU_DATA_DIR}/reference/atlas_label.tiff",
    "transform_type": "SyN",
    "allow_reflection": false,
    "save_upsampled_label_hemisphere_zarr": false
  },
  "segmentation": {
    "method": "threshold",
    "export_mask_tiff": false,
    "cellpose": {
      "model": "cyto3",
      "diameter": 30.0,
      "use_gpu": true,
      "workers": 4,
      "block_size": [
        128,
        256,
        256
      ]
    },
    "threshold": {
      "value": "1000",
      "sigma": 0,
      "min_object_size": 10
    }
  },
  "analysis": {
    "density_config": "pipeline_modules/registration/Region_Csv_Rev1_updated.CSV",
    "output_format": "xlsx",
    "use_hemisphere_label": false
  }
}
