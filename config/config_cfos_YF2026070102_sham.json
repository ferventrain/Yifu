{
  "project_name": "YF2026070102_sham_cfos",
  "input": {
    "description": "Configuration for standard cfos analysis pipeline",
    "resolution_xyz": [
      1.8,
      1.8,
      2.0
    ],
    "channels": {
      "signal": "1",
      "registration": "0"
    }
  },
  "preprocessing": {
    "channel_subtraction": {
      "apply": false,
      "background_channel": "ch0",
      "weight": 1.0,
      "adaptive": true,
      "save_plots": true,
      "sample_ratio": 0.01,
      "min_samples": 10,
      "max_samples": 50,
      "compression": "lzw"
    },
    "tophat": {
      "apply": false,
      "kernel_size": 21
    },
    "rolling_ball": {
      "apply": false,
      "radius": 50
    },
    "scattering_removal": {
      "apply": false,
      "sigma": 25.0,
      "weight": 1.0
    },
    "median_filter": {
      "apply": false,
      "kernel_size": 5
    },
    "clahe": {
      "apply": false,
      "clip_limit": 2.0,
      "tile_grid_size": 8
    },
    "downsample": {
      "target_resolution_xyz": [
        25.0,
        25.0,
        25.0
      ],
      "chunk_size": 100
    },
    "zarr": {
      "chunk_size": [
        256,
        256,
        256
      ],
      "compressor": "default"
    },
    "channels": [
      1,
      2,
      3
    ]
  },
  "registration": {
    "method": "ants",
    "mode": "atlas2image",
    "atlas_path": "${YIFU_DATA_DIR}/reference/atlas.tiff",
    "annotation_path": "${YIFU_DATA_DIR}/reference/atlas_label.tiff",
    "transform_type": "SyNRA",
    "allow_reflection": false,
    "flip_atlas": [
      false,
      false,
      false
    ],
    "save_upsampled_label": false,
    "save_upsampled_label_zarr": true,
    "save_upsampled_label_hemisphere_zarr": true,
    "grad_step": 0.15,
    "syn_iterations": [
      70,
      50,
      30,
      10
    ],
    "halo_mask": true
  },
  "segmentation": {
    "method": "cfos_unet",
    "export_mask_tiff": false,
    "cfos_unet": {
      "checkpoint_path": "${YIFU_DATA_DIR}/models/cfos/best_model.pt",
      "save_probability": false,
      "probability_zarr": "",
      "dataset_name": "0",
      "patch_size": [
        256,
        256,
        256
      ],
      "chunk_size": [
        256,
        256,
        256
      ],
      "normalize_scope": "global",
      "normalize_percentiles": [
        1.0,
        99.5
      ],
      "overlap": 0.25,
      "batch_size": 16,
      "device": "auto",
      "foreground_class": 1,
      "probability_threshold": 0.5,
      "process_existing_only": false,
      "skip_below_threshold": 100.0,
      "rerun_if_model_updated": true,
      "output_mode": "binary",
      "output_dtype": "uint8",
      "probability_dtype": "float16"
    },
    "postprocess": {
      "enabled": true,
      "exclude_edge_px": 40,
      "max_single_slice_voxels": 300,
      "max_voxels": 0,
      "min_voxels": 0,
      "max_extent_ratio": 0.0,
      "downsample_factor": 4
    }
  },
  "analysis": {
    "density_config": "pipeline_modules/registration/Region_Csv_Rev1_updated.CSV",
    "output_format": "xlsx",
    "use_hemisphere_label": true
  },
  "tubule_reconstruction": {
    "enabled": false,
    "dust_threshold": 100,
    "save_skeleton": true,
    "save_swc": false,
    "chunkwise": true,
    "chunk_workers": 8,
    "process_existing_only": true,
    "halo_zyx": [
      2,
      4,
      4
    ],
    "downsample_factor": 4,
    "region_analysis": {
      "enabled": true,
      "all_regions": true,
      "cfg": "pipeline_modules/registration/Region_Csv_Rev1_updated.CSV"
    }
  }
}
